    },
    "settings.media.watermark": {
      "type": "boolean",
      "label": "Image watermark"
    },
    "settings.media.watermarkText": {
      "type": "string",
      "max": 40,
      "label": "Watermark text"
    },
    "settings.afk.enabled": {
      "type": "boolean",
      "label": "AFK system"
    },
    "settings.afk.message": {
      "type": "string",
      "max": 120,
      "label": "AFK default message"
    },
    "settings.game.enabled": {
      "type": "boolean",
      "label": "Game system"
    },
    "settings.game.rpg": {
      "type": "boolean",
      "label": "RPG games"
    },
    "settings.game.dailyReward": {
      "type": "boolean",
      "label": "Daily reward"
    },
