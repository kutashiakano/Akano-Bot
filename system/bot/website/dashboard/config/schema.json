    },
    "settings.automation.autoBackup": {
      "type": "boolean",
      "label": "Auto backup"
    },
    "settings.group.antivirtex": {
      "type": "boolean",
      "label": "Anti virtex"
    },
    "settings.group.antidelete": {
      "type": "boolean",
      "label": "Anti delete"
    },
    "settings.verification.enabled": {
      "type": "boolean",
