{
  "fields": {
    "botname": {
      "type": "string",
      "max": 32,
      "label": "Bot name"
    },
    "prefix": {
      "type": "string",
      "max": 40,
      "label": "Prefixes"
    },
    "settings.maintenance": {
      "type": "boolean",
      "label": "Maintenance mode"
    },
    "settings.limit.enabled": {
      "type": "boolean",
      "label": "Daily limit on"
    },
    "settings.limit.free": {
      "type": "number",
      "min": 0,
      "max": 100000,
      "label": "Free limit"
    },
    "settings.limit.premium": {
      "type": "number",
      "min": 0,
      "max": 1000000,
      "label": "Premium limit"
    },
    "settings.limit.reset": {
      "type": "number",
      "min": 1,
      "max": 72,
      "label": "Reset hours"
