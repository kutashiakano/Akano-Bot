# Akano-Bot environment template
# Copy the needed values into ~/.akano-env (sourced by akano-bot.sh) or export them.

# --- Platform tokens ---
DISCORD_TOKEN=your_discord_bot_token
TELEGRAM_TOKEN=your_telegram_bot_token

# --- Owner(s), comma-separated phone numbers (WA) ---
OWNER=6281234567890
DC_OWNER=your_discord_user_id   # required for owner-gated Discord commands, comma-separated
TG_OWNER=your_telegram_user_id     # required for owner-gated Telegram commands

# --- Memory watchdog: force exit when heap exceeds this MB (default 768) ---
MEM_LIMIT_MB=768

# --- Discord rate limiting ---
DC_DAILY_LIMIT=200

# --- YouTube session: key used to encrypt per-user OAuth credentials at rest ---
# Generate with: openssl rand -hex 16
YT_SESSION_KEY=your_random_hex_key

# --- Optional: full YouTube Music integration (web login, no code entry) ---
# Without these, login uses the built-in YouTube TV flow (URL + code, no setup).
# Web login (no code) needs a Google OAuth client:
# https://console.cloud.google.com -> APIs & Services -> Credentials ->
# Create OAuth client ID -> Application type: "Desktop app"
# (requires "YouTube Data API v3" enabled). Loopback redirect is automatic.
# Set YT_OAUTH_FLOW=device only if your client is "TVs and Limited Input devices".
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_FLOW=web

# --- OAuth callback server (for web login) ---
OAUTH_REDIRECT_PORT=3200